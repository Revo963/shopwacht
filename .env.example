# ShopWacht – Einstellungen. Diese Datei nach ".env" kopieren und den Schlüssel eintragen; alles andere ist optional.

# OpenRouter-Schlüssel von https://openrouter.ai/keys (dort am besten gleich ein Ausgabenlimit setzen).
# Ohne Schlüssel läuft der Demo-Modus mit Stichwort-Heuristik statt der KI-Prüfung.
OPENROUTER_API_KEY=

# Alternativ direkt über TypeSafe (nur wenn OPENROUTER_API_KEY leer ist)
TYPESAFE_API_KEY=

# Optional: Modell überschreiben (OpenRouter: typesafe/jev-1.13, TypeSafe: jev-latest)
# JEV_MODEL=

PORT=3000
# Maximale Produktzahl pro Web-Scan (CLI: --max)
MAX_PRODUCTS=250
# Prüfungen, die in der Web-Oberfläche gleichzeitig laufen dürfen
MAX_ACTIVE_SCANS=1
# Ab dieser Wahrscheinlichkeit gilt ein Befund als "Risiko", darunter bis REVIEW_THRESHOLD als "Prüfen"
RISK_THRESHOLD=0.7
REVIEW_THRESHOLD=0.4

# Produktseiten im Browser prüfen (sieht auch per JavaScript nachgeladene Inhalte):
# auto = Chrome nutzen, falls installiert; browser = immer; static = nur HTML
PAGE_CHECK=auto
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Produktseiten, die gleichzeitig im Browser geöffnet werden (Standard 3). Mehr belastet den Shop stärker und kann ihn zum
# Drosseln bringen.
# PAGE_CONCURRENCY=3

# Zweite Prüfung nach dem Scan (DeepSeek V4 Flash + GLM-5.3 Flash über OpenRouter): entfernt, stuft herab und ergänzt
# Befunde. An, sobald ein OpenRouter-Schlüssel gesetzt ist; entfernte Befunde stehen nur noch im CSV-Export. Abschalten mit:
# SECOND_JUDGE=off
# Kostenlimit je Scan in US-Dollar (Standard 0.30)
# SECOND_JUDGE_MAX_USD=0.30
